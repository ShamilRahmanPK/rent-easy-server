# ── Server ──
NODE_ENV=development
PORT=4000
# Address of the React app (comma-separated for more than one). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
# Public address of the React app. Used to build links inside emails.
APP_URL=http://localhost:5173

# ── Database ──
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/propy_lease_hub?schema=public"

# ── Security ──
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional separate key for the saved SMTP password. Falls back to JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=
# Failed-login and email-link requests allowed per IP address every 15 minutes.
AUTH_RATE_LIMIT=30
# Uploads per minute and public browsing requests per minute, per IP address.
UPLOAD_RATE_LIMIT=30
PUBLIC_RATE_LIMIT=120

# ── Files ──
UPLOAD_DIR=./uploads

# ── Email ──
# console = print emails in the terminal (development). smtp = really send them (production).
MAIL_MODE=console
# Development safety net: send every email to this inbox instead of the real person.
MAIL_REDIRECT_TO=
# Failure alerts go here when an email cannot be delivered after all retries.
ADMIN_ALERT_EMAIL=
# Fallback SMTP settings. A super admin can override them in Settings > Email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RentEasy
SMTP_FROM_ADDRESS=

# ── First super admin (used once by: npm run seed) ──
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin
