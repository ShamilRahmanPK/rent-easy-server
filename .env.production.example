# Copy to /var/www/renteasy/server/.env on the server and fill in every value. Keep the file private: chmod 600 .env

NODE_ENV=production
PORT=4000

# The address of your website, with https. Used for CORS and for links inside emails.
CLIENT_ORIGIN=https://example.com
APP_URL=https://example.com

# setup-server.sh prints this line for you.
DATABASE_URL="postgresql://renteasy:PASSWORD@localhost:5432/renteasy?schema=public"

# Create one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

UPLOAD_DIR=./uploads

# Send real email. Use a mailbox on your own domain.
MAIL_MODE=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM_NAME=RentEasy
SMTP_FROM_ADDRESS=noreply@example.com
# Told when an email cannot be delivered after all retries.
ADMIN_ALERT_EMAIL=you@example.com
MAIL_REDIRECT_TO=

# Rate limits per visitor address. These defaults suit a normal site.
AUTH_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=30
PUBLIC_RATE_LIMIT=120

# First super admin. Used once by "npm run seed". Delete these three lines afterwards.
SEED_SUPER_ADMIN_EMAIL=you@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME="Super Admin"
